# Copy these into Vercel → Project → Settings → Environment Variables
# (KV_* are added automatically when you connect Upstash for Redis from the Storage tab)
KV_REST_API_URL=
KV_REST_API_TOKEN=
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
SETUP_TOKEN=choose-a-private-one-time-setup-code
# Optional: key prefix inside Redis (default 'aura'). Lets Volume 2 share an Upstash database with Volume 1 ('ipk') without mixing data.
DB_PREFIX=aura
